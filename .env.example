# Obrigatorias agora
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?schema=public"
DATABASE_POOL_MAX=5
AUTH_SECRET="gere-um-segredo-longo-com-32-ou-mais-caracteres"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessao e seguranca
COOKIE_SECURE_AUTO=true
SESSION_MAX_AGE_DAYS=30
RATE_LIMIT_ENABLED=true

# Billing local
BILLING_ENFORCEMENT=true
NEXT_PUBLIC_BILLING_ENFORCEMENT=true

# Supabase Postgres/Storage
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
SUPABASE_STORAGE_ENABLED=false

# Stripe
