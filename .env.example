# Obrigatorias agora
# Runtime/Vercel: use a URL pooled/transacional do Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?schema=public&pgbouncer=true&connection_limit=1&pool_timeout=20"
# Prisma CLI/migrations: use a URL direta.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?schema=public"
DATABASE_POOL_MAX=1
DATABASE_POOL_TIMEOUT_MS=5000
AUTH_SECRET="gere-um-segredo-longo-com-32-ou-mais-caracteres"
# Alias aceito em deploys legados/NextAuth.
NEXTAUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessao e seguranca
COOKIE_SECURE_AUTO=true
SESSION_MAX_AGE_DAYS=30
RATE_LIMIT_ENABLED=true

# Billing local
BILLING_ENFORCEMENT=true
NEXT_PUBLIC_BILLING_ENFORCEMENT=true

# Supabase Postgres/Storage
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
SUPABASE_STORAGE_ENABLED=false

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_SCALE=""
STRIPE_PRICE_CREDITS_250=""
STRIPE_PRICE_CREDITS_750=""
STRIPE_PRICE_CREDITS_1500=""
STRIPE_PRICE_CREDITS_3000=""
STRIPE_PRICE_PROPERTIES_50=""
STRIPE_PRICE_PROPERTIES_100=""
STRIPE_PRICE_PROPERTIES_200=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

# Runtime conversacional do COS. O padrao permanece v1; use v2 para ativar o novo nucleo.
COS_RUNTIME_VERSION="v1"

# Marketplace region photography (server-side only)
PEXELS_API_KEY=""

# Luma AI
LUMAAI_API_KEY=""
IMOBISEC_API_KEY=""

# Pedra AI
PEDRA_API_KEY=""

# xAI / Grok (server-side only)
XAI_API_KEY=""

# WhatsApp futuro
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_GRAPH_VERSION="v20.0"
WHATSAPP_WEBHOOK_SECRET=""
WHATSAPP_DEFAULT_COUNTRY_CODE=55

# Email/notificacoes futuras
EMAIL_ENABLED=false
RESEND_API_KEY=""
EMAIL_FROM=""
NOTIFICATIONS_EMAIL_ENABLED=false
