# Obrigatorias agora
# Runtime/Vercel: use a URL pooled/transacional do Supabase.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?schema=public&pgbouncer=true&connection_limit=1&pool_timeout=20"
# Prisma CLI/migrations: use a URL direta.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?schema=public"
DATABASE_POOL_MAX=1
DATABASE_POOL_TIMEOUT_MS=5000
AUTH_SECRET="gere-um-segredo-longo-com-32-ou-mais-caracteres"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessao e seguranca
COOKIE_SECURE_AUTO=true
SESSION_MAX_AGE_DAYS=30
RATE_LIMIT_ENABLED=true

# Billing local
BILLING_ENFORCEMENT=true
NEXT_PUBLIC_BILLING_ENFORCEMENT=true

# Supabase Postgres/Storage
SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""
SUPABASE_STORAGE_ENABLED=false

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BROKER=""
STRIPE_PRICE_AGENCY_BASE=""
# Opcional: alias aceito para o mesmo price principal da imobiliaria.
STRIPE_PRICE_AGENCY=""
# Legado/opcional. A cobranca por corretor adicional deve ser configurada no Stripe
# como medidor/uso dentro do produto da imobiliaria, nao como item separado no checkout.
STRIPE_PRICE_AGENCY_PER_BROKER=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-mini"

