generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BROKER
  AGENCY
  ADMIN
}

enum PropertyStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

enum PropertyType {
  APARTMENT
  HOUSE
  COMMERCIAL
  LAND
  OFFICE
  STORE
  PENTHOUSE
}

enum CatalogOwnerType {
  BROKER
  AGENCY
}

enum SubscriptionOwnerType {
  BROKER
  AGENCY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingPlan {
  NONE
  BROKER
  AGENCY
}

enum BillingUserSubscriptionStatus {
  INACTIVE
  ACTIVE
}

enum StudioCampaignWorkspaceType {
  BROKER
  AGENCY
}

enum StudioCampaignKind {
  INSTAGRAM
  BUYERS
  OWNERS
  SELL_PROPERTY
  CONSTRUCTION
  PROPERTY_PREPARATION
  VIDEO
}

enum StudioCampaignStatus {
  DRAFT
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
}

enum StudioCampaignAssetType {
  IMAGE
  VIDEO
  CAROUSEL
  STORY
  REEL
  COPY
  THUMBNAIL
}

enum StudioCampaignAssetStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  FAILED
}

enum BrokerAccountStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum CreciValidationStatus {
  VERIFIED
  REJECTED
  REVIEW_REQUIRED
  PENDING
}

enum CreciValidationProvider {
  IMOBISEC
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  WON
  LOST
  ARCHIVED
}

enum MarketplaceConversationStatus {
  OPEN
  CLOSED
}

enum MarketplaceMessageSender {
  CUSTOMER
  BROKER
}

enum MarketplaceMessageKind {
  TEXT
  PROPERTY
  PROPOSAL
}

enum MarketplaceReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum MarketplaceReviewOrigin {
  POST_CHAT
  PUBLIC_PROFILE
}

model User {
  id                      String                        @id @default(cuid())
  name                    String
  email                   String                        @unique
  passwordHash            String
  pinHash                 String?
  role                    UserRole
  phone                   String?
  photoUrl                String?
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  plan                    BillingPlan                   @default(NONE)
  subscriptionStatus      BillingUserSubscriptionStatus @default(INACTIVE)
  createdAt               DateTime                      @default(now())
  broker                  Broker?
  ownedAgency             Agency?                       @relation("AgencyOwner")
  notifications           Notification[]
  leads                   Lead[]
  aiAssistantInteractions AiAssistantInteraction[]
  emeMessages             EmeMessage[]
  studioCampaigns         StudioCampaign[]
  trustedDevices          UserTrustedDevice[]
  passkeyCredentials      UserPasskeyCredential[]
}

model UserTrustedDevice {
  id                   String                  @id @default(cuid())
  userId               String
  tokenHash            String                  @unique
  label                String
  browser              String?
  platform             String?
  userAgent            String?
  biometricEnabled     Boolean                 @default(false)
  pinFailures          Int                     @default(0)
  lastAccessAt         DateTime?
  lastPasswordLoginAt  DateTime?
  lastPinLoginAt       DateTime?
  lastBiometricLoginAt DateTime?
  trustedAt            DateTime                @default(now())
  revokedAt            DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  passkeyCredentials   UserPasskeyCredential[]

  @@index([userId, revokedAt])
  @@index([userId, lastAccessAt])
}

model UserPasskeyCredential {
  id           String            @id @default(cuid())
  userId       String
  deviceId     String
  credentialId String            @unique
  publicKey    Bytes
  counter      Int               @default(0)
  transports   Json?
  deviceType   String?
  backedUp     Boolean           @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       UserTrustedDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId])
}

model Broker {
  propertyCapacityEvents BrokerPropertyCapacityEvent[]
  id                        String                     @id @default(cuid())
  userId                    String                     @unique
  agencyId                  String?
  phone                     String
  catalogSlug               String                     @unique
  status                    BrokerAccountStatus        @default(ACTIVE)
  creci                     String?
  creciUf                   String?
  creciValidationStatus     CreciValidationStatus      @default(PENDING)
  creciValidatedAt          DateTime?
  creciOfficialName         String?
  creciOfficialRegistration String?
  creciProviderStatus       String?
  creciValidationProvider   CreciValidationProvider?
  creciNameMismatch         Boolean                    @default(false)
  description               String?
  catalogBannerUrl          String?
  catalogHeadline           String?
  catalogBio                String?
  catalogExperienceYears    Int?
  catalogSoldProperties     Int?
  catalogServiceArea        String?
  catalogCities             Json?
  catalogPriceRange         String?
  catalogSpecialties        Json?
  catalogDifferentials      Json?
  catalogVideoUrl           String?
  brandColor                String?
  logoUrl                   String?
  showAgencyWatermark       Boolean                    @default(true)
  marketplaceSpecialties    String[]                   @default([])
  marketplaceRegion         String?
  marketplaceTransactions   String?                    @default("BOTH")
  marketplaceAbout          String?
  marketplaceFeatured       Boolean                    @default(false)
  marketplaceRating         Decimal?                   @db.Decimal(2, 1)
  marketplaceReviewCount    Int                        @default(0)
  aiCreditsBalance          Int                        @default(30)
  aiCreditsUsedThisMonth    Int                        @default(0)
  aiAssistantEnabled        Boolean                    @default(true)
  aiMonthlyUsage            Int                        @default(0)
  aiLastInteractionAt       DateTime?
  createdAt                 DateTime                   @default(now())
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  agency                    Agency?                    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  properties                Property[]
  leads                     Lead[]
  catalogEvents             CatalogEvent[]
  searchEvents              SearchEvent[]
  agendaEvents              AgendaEvent[]
  documents                 BrokerDocument[]
  aiAssistantInteractions   AiAssistantInteraction[]
  planAccount               BrokerPlanAccount?
  propertyCapacityAddon     BrokerPropertyCapacityAddon?
  aiCreditTransactions      AiCreditTransaction[]
  extraPackagePurchases     ExtraPackagePurchase[]
  corretorEmeConfig         BrokerEmeConfig?
  financialConfig           BrokerFinancialConfig?
  emeMessages               EmeMessage[]
  studioCampaigns           StudioCampaign[]
  contractTemplates         ContractTemplate[]
  contractTemplateInstances ContractTemplateInstance[]
  marketplaceConversations  MarketplaceConversation[]
  marketplaceReviews        MarketplaceReview[]
}

model Agency {
  id              String           @id @default(cuid())
  ownerUserId     String           @unique
  name            String
  catalogSlug     String           @unique
  phone           String?
  cnpj            String?
  logoUrl         String?
  description     String?
  brandColor      String?
  createdAt       DateTime         @default(now())
  ownerUser       User             @relation("AgencyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  brokers         Broker[]
  properties      Property[]
  leads           Lead[]
  catalogEvents   CatalogEvent[]
  studioCampaigns StudioCampaign[]
}

model Property {
  id                        String                     @id @default(cuid())
  publicCode                Int?
  title                     String
  description               String?
  audioUrl                  String?
  price                     Int
  city                      String
  neighborhood              String?
  ownerName                 String?
  bedrooms                  Int                        @default(0)
  bathrooms                 Int                        @default(0)
  parkingSpots              Int                        @default(0)
  type                      PropertyType               @default(APARTMENT)
  purpose                   String                     @default("SALE")
  status                    PropertyStatus             @default(DRAFT)
  published                 Boolean                    @default(false)
  marketplacePublished      Boolean                    @default(false)
  marketplacePublishedAt    DateTime?
  marketplaceSlug           String?                    @unique
  imageUrls                 Json?
  legalData                 Json?
  documentsData             Json?
  viewsCount                Int                        @default(0)
  leadsCount                Int                        @default(0)
  brokerId                  String
  agencyId                  String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  broker                    Broker                     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  agency                    Agency?                    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  leads                     Lead[]
  catalogEvents             CatalogEvent[]
  emeMessages               EmeMessage[]
  agendaEvents              AgendaEvent[]
  documents                 BrokerDocument[]
  studioCampaigns           StudioCampaign[]
  contractTemplateInstances ContractTemplateInstance[]
  marketplaceConversations  MarketplaceConversation[]

  @@unique([brokerId, publicCode])
  @@index([marketplacePublished, marketplacePublishedAt])
}

model BrokerEmeConfig {
  id                     String    @id @default(cuid())
  brokerId               String    @unique
  whatsApp               String?
  displayName            String?
  initialMessage         String?
  status                 String    @default("IN_PREPARATION")
  notes                  String?
  provider               String?
  phoneNumberId          String?
  accessTokenEncrypted   String?
  webhookVerifyToken     String?
  webhookStatus          String    @default("NOT_CONFIGURED")
  lastWebhookEventAt     DateTime?
  integrationRequestedAt DateTime?
  integrationActivatedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  broker                 Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
}

model AssessorEmeConfig {
  id                   String   @id @default(cuid())
  officialNumber       String?
  displayName          String?
  status               String   @default("IN_PREPARATION")
  internalInstructions String?
  notes                String?
  provider             String?
  phoneNumberId        String?
  webhookVerifyToken   String?
  webhookStatus        String   @default("NOT_CONFIGURED")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model BrokerFinancialConfig {
  id                String   @id @default(cuid())
  brokerId          String   @unique
  commissionPercent Float    @default(6)
  calculationType   String   @default("Todos os imóveis")
  statusFilter      String   @default("Todos")
  typeFilter        String   @default("Todos")
  viewMode          String   @default("Geral")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  broker            Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
}

model EmeMessage {
  id             String    @id @default(cuid())
  brokerId       String
  userId         String?
  leadId         String?
  propertyId     String?
  channel        String
  direction      String
  fromPhone      String?
  customerName   String?
  message        String
  response       String?
  detectedIntent String?
  actionType     String?
  actionStatus   String?
  metadata       Json?
  errorMessage   String?
  creditsUsed    Int       @default(0)
  createdAt      DateTime  @default(now())
  broker         Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property       Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([brokerId, channel, createdAt])
  @@index([leadId, createdAt])
  @@index([propertyId, createdAt])
  @@index([userId, createdAt])
}

model CatalogEvent {
  id          String    @id @default(cuid())
  eventType   String
  source      String    @default("catalog")
  catalogSlug String?
  visitorKey  String?
  propertyId  String?
  brokerId    String?
  agencyId    String?
  createdAt   DateTime  @default(now())
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker      Broker?   @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency      Agency?   @relation(fields: [agencyId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([source, createdAt])
  @@index([brokerId, createdAt])
  @@index([agencyId, createdAt])
  @@index([propertyId, createdAt])
  @@index([catalogSlug, createdAt])
  @@index([visitorKey, eventType, createdAt])
}

model SearchEvent {
  id          String   @id @default(cuid())
  brokerId    String
  query       String
  filters     Json?
  resultCount Int      @default(0)
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  broker      Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, createdAt])
  @@index([source, createdAt])
}

model AgendaEvent {
  id         String    @id @default(cuid())
  brokerId   String
  title      String
  type       String    @default("task")
  date       DateTime
  time       String?
  leadId     String?
  propertyId String?
  notes      String?
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  broker     Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([brokerId, date])
  @@index([brokerId, status])
  @@index([leadId])
  @@index([propertyId])
}

model BrokerDocument {
  id               String                    @id @default(cuid())
  brokerId         String
  leadId           String?
  propertyId       String?
  type             String                    @default("proposal")
  title            String
  content          String
  status           String                    @default("draft")
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  broker           Broker                    @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead             Lead?                     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property         Property?                 @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  templateInstance ContractTemplateInstance?

  @@index([brokerId, createdAt])
  @@index([brokerId, status])
  @@index([leadId])
  @@index([propertyId])
}

model ContractTemplate {
  id             String                     @id @default(cuid())
  workspaceId    String
  brokerId       String
  name           String
  status         String                     @default("ANALYZING")
  sourceHash     String
  currentVersion Int                        @default(1)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  broker         Broker                     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  versions       ContractTemplateVersion[]
  instances      ContractTemplateInstance[]

  @@unique([workspaceId, sourceHash])
  @@index([brokerId, status, updatedAt])
}

model ContractTemplateVersion {
  id                String                     @id @default(cuid())
  templateId        String
  version           Int
  status            String                     @default("ANALYZING")
  sourceFileName    String
  sourceStoragePath String?
  sourceMimeType    String
  sourceFileSize    Int?
  originalText      String                     @db.Text
  structure         Json
  analysisMetadata  Json?
  reviewedAt        DateTime?
  createdAt         DateTime                   @default(now())
  template          ContractTemplate           @relation(fields: [templateId], references: [id], onDelete: Cascade)
  instances         ContractTemplateInstance[]

  @@unique([templateId, version])
  @@index([templateId, status])
}

model ContractTemplateInstance {
  id                String                  @id @default(cuid())
  workspaceId       String
  brokerId          String
  templateId        String
  templateVersionId String
  brokerDocumentId  String?                 @unique
  leadId            String?
  propertyId        String?
  title             String
  status            String                  @default("draft")
  values            Json
  additionalParties Json
  readiness         Int                     @default(0)
  signedAt          DateTime?
  signatureNote     String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  broker            Broker                  @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  template          ContractTemplate        @relation(fields: [templateId], references: [id], onDelete: Restrict)
  templateVersion   ContractTemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  brokerDocument    BrokerDocument?         @relation(fields: [brokerDocumentId], references: [id], onDelete: SetNull)
  lead              Lead?                   @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property          Property?               @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([brokerId, status, updatedAt])
  @@index([templateId, createdAt])
  @@index([leadId])
  @@index([propertyId])
}

model StudioCampaign {
  id              String                      @id @default(cuid())
  workspaceType   StudioCampaignWorkspaceType
  kind            StudioCampaignKind
  status          StudioCampaignStatus        @default(DRAFT)
  goal            String?
  visualIdentity  String?
  version         Int                         @default(1)
  provider        String?
  model           String?
  prompt          String?
  promptRevised   String?
  sourceRoute     String?
  metadata        Json?
  brokerId        String?
  agencyId        String?
  propertyId      String?
  createdByUserId String
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  broker          Broker?                     @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  agency          Agency?                     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  property        Property?                   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  createdByUser   User                        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  assets          StudioCampaignAsset[]

  @@index([brokerId, kind, createdAt])
  @@index([agencyId, kind, createdAt])
  @@index([propertyId, kind, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([workspaceType, kind, createdAt])
}

model StudioCampaignAsset {
  id            String                    @id @default(cuid())
  campaignId    String
  assetKey      String
  label         String?
  type          StudioCampaignAssetType
  prompt        String?
  promptRevised String?
  provider      String?
  model         String?
  fileUrl       String?
  thumbnailUrl  String?
  status        StudioCampaignAssetStatus @default(DRAFT)
  approvedAt    DateTime?
  content       Json?
  metadata      Json?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  campaign      StudioCampaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, assetKey])
  @@index([campaignId, status])
  @@index([type, createdAt])
}

model Catalog {
  id        String           @id @default(cuid())
  slug      String           @unique
  ownerType CatalogOwnerType
  ownerId   String
  createdAt DateTime         @default(now())

  @@index([ownerType, ownerId])
}

model AiAssistantInteraction {
  id           String   @id @default(cuid())
  userId       String
  brokerId     String
  prompt       String
  response     String
  actionType   String
  creditsUsed  Int      @default(1)
  channel      String   @default("assessor_eme")
  intent       String?
  actionStatus String?
  metadata     Json?
  errorMessage String?
  leadId       String?
  propertyId   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  broker       Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, createdAt])
  @@index([userId, createdAt])
  @@index([channel, createdAt])
  @@index([leadId])
  @@index([propertyId])
}

model Subscription {
  id            String                @id @default(cuid())
  ownerType     SubscriptionOwnerType
  ownerId       String
  status        SubscriptionStatus    @default(TRIALING)
  nextBillingAt DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  cancelAt          DateTime?
  createdAt     DateTime              @default(now())

  @@unique([ownerType, ownerId])
  @@index([ownerType, ownerId])
}

model BrokerPlanAccount {
  id                            String    @id @default(cuid())
  brokerId                      String    @unique
  planKey                       String    @default("free")
  propertyExtraLimit            Int       @default(0)
  initialCreditsGrantedAt       DateTime?
  currentPeriodCreditsGrantedAt DateTime?
  currentStripeSubscriptionId   String?
  currentStripePeriodStart      DateTime?
  currentStripePeriodEnd        DateTime?
  currentPeriodGrantedCredits   Int       @default(0)
  currentPeriodGrantPlanKey     String?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  broker                        Broker    @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([planKey])
}

model BrokerPropertyCapacityAddon {
  id                       String   @id @default(cuid())
  brokerId                 String   @unique
  quantity                 Int
  stripePriceId            String
  stripeSubscriptionId     String
  stripeSubscriptionItemId String   @unique
  status                   String   @default("ACTIVE")
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  startedAt                DateTime @default(now())
  endedAt                  DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  broker                   Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
  @@index([status])
}

model BrokerPropertyCapacityEvent {
  id                       String   @id @default(cuid())
  brokerId                 String
  action                   String
  previousQuantity         Int?
  quantity                 Int?
  previousStripePriceId    String?
  stripePriceId            String?
  stripeSubscriptionId     String
  stripeSubscriptionItemId String?
  effectiveAt              DateTime
  createdAt                DateTime @default(now())
  broker                   Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, effectiveAt])
  @@index([stripeSubscriptionId])
  @@index([action])
}

model AiCreditTransaction {
  id           String   @id @default(cuid())
  brokerId     String
  grantKey     String?  @unique
  type         String
  amount       Int
  balanceAfter Int
  actionType   String?
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now())
  broker       Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, createdAt])
  @@index([type, createdAt])
}

model AiOperationTelemetry {
  id                String   @id @default(cuid())
  operationKey      String
  module            String
  feature           String
  capability        String?
  handler           String?
  route             String?
  provider          String
  model             String?
  status            String
  errorCode         String?
  errorMessage      String?
  source            String?
  workflowId        String?
  conversationId    String?
  userId            String?
  brokerId          String?
  agencyId          String?
  planKey           String?
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  reasoningTokens   Int?
  totalTokens       Int?
  imageCount        Int      @default(0)
  videoCount        Int      @default(0)
  audioCount        Int      @default(0)
  storageBytes      Int?
  durationMs        Int?
  costUsd           Decimal? @db.Decimal(12, 6)
  costBrl           Decimal? @db.Decimal(12, 6)
  creditsConsumed   Int?
  retryCount        Int      @default(0)
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([operationKey, createdAt])
  @@index([provider, createdAt])
  @@index([brokerId, createdAt])
  @@index([userId, createdAt])
  @@index([planKey, createdAt])
  @@index([status, createdAt])
}

model ExtraPackagePurchase {
  id                      String   @id @default(cuid())
  brokerId                String
  packageKey              String
  packageType             String
  quantity                Int
  amountCents             Int
  status                   String   @default("registered")
  stripeCheckoutSessionId String?  @unique
  stripePaymentIntentId   String?  @unique
  stripeFulfilledEventId  String?  @unique
  metadata                Json?
  createdAt               DateTime @default(now())
  broker                  Broker   @relation(fields: [brokerId], references: [id], onDelete: Cascade)

  @@index([brokerId, createdAt])
  @@index([packageKey])
  @@index([status])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  title      String
  message    String
  read       Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Lead {
  id                        String                     @id @default(cuid())
  name                      String?
  email                     String?
  phone                     String?
  whatsapp                  String?
  message                   String?
  catalogSlug               String?
  searchTerm                String?
  intent                    String?
  source                    String
  status                    LeadStatus                 @default(NEW)
  legalData                 Json?
  addressData               Json?
  documentsData             Json?
  propertyId                String?
  brokerId                  String?
  agencyId                  String?
  userId                    String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  property                  Property?                  @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  broker                    Broker?                    @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  agency                    Agency?                    @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  user                      User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)
  emeMessages               EmeMessage[]
  agendaEvents              AgendaEvent[]
  documents                 BrokerDocument[]
  contractTemplateInstances ContractTemplateInstance[]
  marketplaceConversations  MarketplaceConversation[]
  marketplaceReviews        MarketplaceReview[]

  @@index([propertyId])
  @@index([brokerId])
  @@index([agencyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model MarketplaceConversation {
  id                String                        @id @default(cuid())
  publicToken       String                        @unique @default(uuid())
  brokerId          String
  propertyId        String?
  leadId            String?
  customerName      String
  customerPhone     String
  status            MarketplaceConversationStatus @default(OPEN)
  lastMessageAt     DateTime                      @default(now())
  closedAt          DateTime?
  reviewRequestedAt DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  broker            Broker                        @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  property          Property?                     @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  lead              Lead?                         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages          MarketplaceMessage[]
  review            MarketplaceReview?

  @@index([brokerId, lastMessageAt])
  @@index([propertyId, lastMessageAt])
  @@index([leadId])
  @@index([status, lastMessageAt])
}

model MarketplaceMessage {
  id             String                   @id @default(cuid())
  conversationId String
  sender         MarketplaceMessageSender
  kind           MarketplaceMessageKind   @default(TEXT)
  body           String
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime                 @default(now())
  conversation   MarketplaceConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model MarketplaceReview {
  id                  String                   @id @default(cuid())
  conversationId      String?                  @unique
  brokerId            String
  leadId              String?
  authorName          String
  authorPhone         String?
  rating              Int
  comment             String
  origin              MarketplaceReviewOrigin  @default(PUBLIC_PROFILE)
  verified            Boolean                  @default(false)
  attendanceConfirmed Boolean                  @default(false)
  status              MarketplaceReviewStatus  @default(PENDING_REVIEW)
  moderatedAt         DateTime?
  moderatorUserId     String?
  rejectionReason     String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  conversation        MarketplaceConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  broker              Broker                   @relation(fields: [brokerId], references: [id], onDelete: Cascade)
  lead                Lead?                    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([brokerId, status, createdAt])
  @@index([brokerId, authorPhone, createdAt])
  @@index([leadId])
  @@index([status, createdAt])
}

model MarketplaceRegionMedia {
  slug              String   @id
  displayName       String?
  city              String?
  state             String?
  ibgeCode          String?  @unique
  provider          String   @default("eme")
  pexelsPhotoId     String?
  imageUrl          String
  originalUrl       String?
  photoPageUrl      String?
  photographer      String?
  photographerUrl   String?
  query             String?
  resolvedAt        DateTime?
  source            String   @default("automatic")
  manualImageUrl    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([state, city])
}
